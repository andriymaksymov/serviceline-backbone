# ==============================================================================
# serviceline-backbone Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control (it contains secrets)

# ==============================================================================
# Core Infrastructure
# ==============================================================================

# RabbitMQ Message Broker
# Credentials for the broker container (docker-compose substitutes these). Generate e.g.: openssl rand -hex 24
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
# Workers must log in with the same credentials (the default "guest" user only works from localhost).
# Inside docker-compose the host is "rabbitmq"; URL-encode special characters in the password.
RABBITMQ_URL=amqp://admin:change-me@rabbitmq:5672/%2F
RABBITMQ_EXCHANGE=serviceline

# Redis for Session & Approval Storage
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# OpenAI / LLM Configuration (REQUIRED)
# ==============================================================================

# Your OpenAI API key - get from https://platform.openai.com/account/api-keys
# Must start with 'sk-' for OpenAI keys
OPENAI_API_KEY=sk-your-api-key-here-replace-me

# OpenAI model to use (see https://platform.openai.com/docs/models)
# Options: gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Embeddings Configuration
# ==============================================================================

# HTTP endpoint for embedding service
# Examples:
#   - Local: http://localhost:8001/embed  (bundled serviceline_backbone/embeddings service, host port)
#   - Docker: http://embeddings:8000/embed
#   - Remote: https://api.example.com/embed
EMBEDDING_SERVICE_URL=http://embeddings:8000/embed

# Embedding model name (passed to your embedding service)
# Common options: BAAI/bge-small-en-v1.5, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ==============================================================================
# Qdrant Vector Database Configuration
# ==============================================================================

# Qdrant instance URL
QDRANT_URL=http://localhost:6333

# Collection name in Qdrant where knowledge base is stored
QDRANT_COLLECTION=knowledge

# Minimum similarity score (0.0-1.0) for context retrieval
# Lower values = more context (but less relevant)
# Higher values = fewer but more relevant results
# Default 0.35 works well for most cases
CONFIDENCE_THRESHOLD=0.35

# ==============================================================================
# WhatsApp Integration
# ==============================================================================

# Webhook secret for validating incoming messages (REQUIRED)
# Generate a strong random string, e.g.: openssl rand -hex 32
# All webhook requests must include a matching X-Webhook-Secret header; if unset, the webhook rejects everything (503)
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-here-replace-me

# WhatsApp Business API endpoint for sending messages
# Format: https://graph.facebook.com/v19.0/<PHONE_NUMBER_ID>/messages
# You need to have a WhatsApp Business API account
WHATSAPP_OUTBOUND_URL=https://graph.facebook.com/v19.0/123456789/messages

# Reviewer's WhatsApp phone number (international format)
# Messages requiring approval are sent to this account
# Example: +15551234567 (USA)
WHATSAPP_TARGET_ACCOUNT=+15551234567

# ==============================================================================
# Session & Approval Settings
# ==============================================================================

# How long to wait (in seconds) before aggregating a session
# Lower values = faster response but may split multi-message conversations
# Higher values = better message aggregation but higher latency
# Typical: 10-60 seconds
REDIS_SESSION_TTL_SECONDS=30

# How long (in seconds) to keep pending approvals in Redis
# After this time, the approval is discarded and message won't be sent
# Default: 86400 (24 hours)
APPROVAL_TTL_SECONDS=86400

# Command prefix for approval messages
# Reviewer sends: <PREFIX> <session_id> <approved_text>
# Example: /ok session-123 Thanks for your question!
APPROVAL_COMMAND_PREFIX=/ok

# ==============================================================================
# System Prompt & Storage
# ==============================================================================

# Path to system prompt file that guides the AI
# This text is included in every OpenAI API call
# Create this file with instructions like:
#   "You are a helpful customer service assistant..."
SYSTEM_PROMPT_PATH=./config/system_prompt.txt

# Root directory where incoming messages are archived
# Creates structure: <ROOT>/<sender>/YYYY/MM/DD/HHMMSS-message_id.json
STORAGE_ROOT=./data/messages

# ==============================================================================
# Logging (optional)
# ==============================================================================

# Python logging level (DEBUG, INFO, WARNING, ERROR)
# Set to DEBUG for detailed troubleshooting
# LOG_LEVEL=INFO

# Ensure Python output is not buffered (useful for Docker logs)
PYTHONUNBUFFERED=1

# ==============================================================================
# Production Deployment (optional)
# ==============================================================================

# If using managed Redis/RabbitMQ with TLS:
# RABBITMQ_URL=amqps://user:pass@rabbitmq.example.com:5671/%2F
# REDIS_URL=rediss://default:password@redis.example.com:6379/0
